{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "libs/*": ["./src/libs/*"]
    }
  },
  "include": ["src"]
}
