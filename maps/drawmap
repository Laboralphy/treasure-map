#!/bin/bash
#
# Renders a rectangular region of the world to maps/map.x<x>.y<y>.s<seed>.png
#
# usage: ./drawmap <x> <y> <width> <height> <seed> [extra tile options...]
#
# The tile tool now renders whole blocks by itself, so there is no more per-tile
# temporary file and no more ImageMagick stitching. Anything you add after <seed> is
# forwarded to the tool : --tile-size, --scale, --physic-grid-size, --no-grid.
# Run `npm run tile -- --help` for the full list.

set -e

if [ $# -lt 5 ]; then
  echo "usage: $0 <x> <y> <width> <height> <seed> [extra tile options...]"
  exit 1
fi

x="$1"; y="$2"; w="$3"; h="$4"; s="$5"
shift 5

cd "$(dirname "$0")/.."
npm run --silent tile -- \
  --x="$x" --y="$y" --cols="$w" --rows="$h" --seed="$s" \
  --output="maps/map.x$x.y$y.s$s.png" "$@"
